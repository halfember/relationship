* text=auto

# Keep source and Linux deployment files portable across Windows and Linux.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.service text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Preserve binary assets exactly.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
